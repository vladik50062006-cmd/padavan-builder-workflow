CONFIG_VENDOR="ASUS"
CONFIG_FIRMWARE_PRODUCT_ID="RT-AC51U"

# Базовые системные модули
CONFIG_FIRMWARE_ENABLE_USB=n
CONFIG_FIRMWARE_ENABLE_IPV6=y

# Аппаратное ускорение (HW NAT)
CONFIG_FIRMWARE_INCLUDE_OFFLOAD=y
CONFIG_FIRMWARE_INCLUDE_BWUSERS=y

# Отключаем 5GHz Wi-Fi
CONFIG_FIRMWARE_INCLUDE_5G=n

# Отключаем USB-сервисы и файловые системы
CONFIG_FIRMWARE_INCLUDE_FAT=n
CONFIG_FIRMWARE_INCLUDE_EXFAT=n
CONFIG_FIRMWARE_INCLUDE_NTFS=n
CONFIG_FIRMWARE_INCLUDE_EXT2=n
CONFIG_FIRMWARE_INCLUDE_EXT3=n
CONFIG_FIRMWARE_INCLUDE_EXT4=n
CONFIG_FIRMWARE_INCLUDE_SAMBA=n
CONFIG_FIRMWARE_INCLUDE_FTP=n
CONFIG_FIRMWARE_INCLUDE_SFTP=n
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n
CONFIG_FIRMWARE_INCLUDE_TORRENT=n
CONFIG_FIRMWARE_INCLUDE_PRINTER=n

# Отключаем тяжелые VPN и прокси
CONFIG_FIRMWARE_INCLUDE_PPTP=n
CONFIG_FIRMWARE_INCLUDE_L2TP=n
CONFIG_FIRMWARE_INCLUDE_IPSEC=n
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=n
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n
CONFIG_FIRMWARE_INCLUDE_SHADOWSOCKS=n
CONFIG_FIRMWARE_INCLUDE_HTTPS=y
